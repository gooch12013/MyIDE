#!/bin/sh
# todo "what to do" [@role] [#tag]: adds to MyIDE's to-do list; @sysadmin (lab-ops, assistant, desktop) also
# assigns it to that This Mac employee, which plans it read-only and waits for GO. Installed by MyIDE into ~/.myide/bin.
set -u
[ $# -ge 1 ] && [ -n "$1" ] || { echo 'usage: todo "what to do" [@role] [#tag]' >&2; exit 2; }
ep="${MYIDE_HOME:-$HOME/.myide}/issue-endpoint.json"
[ -r "$ep" ] || { echo 'MyIDE is not running.' >&2; exit 1; }
url=$(sed -n 's/.*"url": *"\([^"]*\)\/issue".*/\1/p' "$ep")/todo
# The token is read from the file inside osascript and goes in the request body, so it never shows in argv.
json=$(osascript -l JavaScript -e 'function run(a){var ep=JSON.parse(ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(a[0],4,null)));
  return JSON.stringify({text:a.slice(1).join(" "),token:ep.token})}' "$ep" "$@") || exit 1
if out=$(printf '%s' "$json" | curl -sS --fail-with-body --max-time 120 -H 'Content-Type: application/json' --data-binary @- "$url" 2>/dev/null); then
  echo "$out"
else
  echo "${out:-MyIDE is not running.}" >&2
  exit 1
fi
