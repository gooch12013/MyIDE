#!/bin/sh
# issue PROJECT "title": files an issue on PROJECT's forge through the running MyIDE
# (same attribution strip and outbox as the New issue form). Installed by MyIDE into ~/.myide/bin.
set -u
[ $# -eq 2 ] && [ -n "$2" ] || { echo 'usage: issue PROJECT "title"' >&2; exit 2; }
ep="${MYIDE_HOME:-$HOME/.myide}/issue-endpoint.json"
[ -r "$ep" ] || { echo 'MyIDE is not running.' >&2; exit 1; }
url=$(sed -n 's/.*"url": *"\([^"]*\)".*/\1/p' "$ep")
# The token is read from the file inside osascript and goes in the request body, so it never shows in argv.
json=$(osascript -l JavaScript -e 'function run(a){var ep=JSON.parse(ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(a[0],4,null)));
  return JSON.stringify({project:a[1],title:a[2],token:ep.token})}' "$ep" "$1" "$2") || exit 1
if out=$(printf '%s' "$json" | curl -sS --fail-with-body --max-time 60 -H 'Content-Type: application/json' --data-binary @- "$url" 2>/dev/null); then
  echo "$out"
else
  echo "${out:-MyIDE is not running.}" >&2
  exit 1
fi
