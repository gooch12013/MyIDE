#!/bin/sh
# MyIDE employee worktrees: drop AI attribution lines from the commit message (patterns from
# attribution-patterns beside this file), then run the repository's own commit-msg hook.
dir=$(dirname "$0")
msg=$1
grep -Eiv -f "$dir/attribution-patterns" "$msg" | awk 'NF { for (; n > 0; n--) print ""; print; next } { n++ }' > "$msg.myide"
mv "$msg.myide" "$msg"

hp=$(git config --local core.hooksPath 2>/dev/null || git config --global core.hooksPath || echo "$(git rev-parse --git-common-dir 2>/dev/null)/hooks")
case $hp in "~/"*) hp="$HOME/${hp#"~/"}" ;; esac
own="$hp/commit-msg"
if [ -x "$own" ] && [ "$own" != "$0" ]; then exec "$own" "$@"; fi
exit 0
